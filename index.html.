<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BikeLock Sentinel - IoT Dashboard</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.4); opacity: 0.2; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .pulse-ring-anim {
      animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes emergency-flash {
      0%, 100% { background-color: rgba(220, 38, 38, 0.25); border-color: rgba(239, 68, 68, 0.8); }
      50% { background-color: rgba(185, 28, 28, 0.6); border-color: rgba(248, 113, 113, 1); }
    }
    .emergency-alarm {
      animation: emergency-flash 1s infinite alternate;
    }
    #map {
      height: 100%;
      min-height: 440px;
      border-radius: 0.75rem;
      z-index: 10;
    }
    .dark-map .leaflet-tile {
      filter: brightness(0.65) invert(1) contrast(3) hue-rotate(200deg) saturate(0.3) brightness(0.75);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col">

  <!-- Top Emergency Alert Bar (Theft) -->
  <div id="emergencyBar" class="hidden emergency-alarm border-b-2 border-red-600 px-4 py-3 text-red-100 flex items-center justify-between shadow-2xl z-50">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-red-600 rounded-full animate-bounce">
        <i data-lucide="shield-alert" class="w-6 h-6 text-white"></i>
      </div>
      <div>
        <p class="font-black text-lg tracking-wide text-white">התראת גניבה קריטית: זוהה חיתוך דיסק ללא נוכחות בעלים!</p>
        <p class="text-xs text-red-200" id="emergencyStatusText">הבקר התעורר מ-Deep Sleep • שרת Render מזניק שיחת חירום ב-Twilio</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="silenceSiren()" id="muteBtn" class="px-3 py-1.5 bg-red-800 hover:bg-red-700 text-white rounded-lg text-sm font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="volume-x" class="w-4 h-4"></i>
        השתק צופר
      </button>
      <button onclick="dismissAlarm()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="check" class="w-4 h-4"></i>
        אני ליד האופניים (בטל אזעקה)
      </button>
    </div>
  </div>

  <!-- Header -->
  <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur px-6 py-4 flex flex-wrap justify-between items-center gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400">
        <i data-lucide="lock" class="w-5 h-5"></i>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-lg font-bold text-slate-100">BikeLock Sentinel</h1>
          <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Render Connected</span>
        </div>
        <p class="text-xs text-slate-400">דשבורד אבטחה אישי למניעת גניבות • מחובר לענן בשידור חי</p>
      </div>
    </div>

    <!-- Quick Status Pill -->
    <div class="flex items-center gap-3 flex-wrap">
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700">
        <span id="controllerStateDot" class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span id="controllerStateText" class="text-xs font-semibold text-slate-200">DEEP SLEEP</span>
      </div>

      <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700">
        <i data-lucide="battery" class="w-4 h-4 text-emerald-400"></i>
        <span id="batteryDisplay" class="text-xs font-semibold text-slate-200">96%</span>
      </div>
    </div>
  </header>

  <!-- Main Content Grid -->
  <main class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-7xl mx-auto w-full">
    
    <!-- Left Column: Map (8 Cols) -->
    <div class="lg:col-span-8 flex flex-col gap-4">
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex flex-col flex-1 shadow-lg">
        <div class="flex justify-between items-center mb-3">
          <div class="flex items-center gap-2">
            <i data-lucide="map-pin" class="w-5 h-5 text-indigo-400"></i>
            <h2 class="text-sm font-bold text-slate-200">מיקום GPS נוכחי והיסטוריית תנועה</h2>
          </div>
          <div class="flex items-center gap-2">
            <span id="gpsFixBadge" class="text-[11px] px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 font-mono">
              GPS Standby
            </span>
            <button onclick="centerMap()" class="p-1.5 hover:bg-slate-800 rounded-md text-slate-400 hover:text-slate-200 transition" title="מרכז מפה">
              <i data-lucide="crosshair" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <!-- Map Container -->
        <div class="flex-1 w-full rounded-xl overflow-hidden relative border border-slate-800/80">
          <div id="map" class="dark-map"></div>
          
          <div class="absolute bottom-3 left-3 bg-slate-900/90 backdrop-blur border border-slate-700/80 p-2.5 rounded-xl z-[400] text-xs font-mono flex gap-4 text-slate-300 shadow-xl">
            <div>
              <span class="text-slate-500 block text-[10px]">קו אורך / רוחב</span>
              <span id="coordsDisplay">32.0853, 34.7818</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">מהירות</span>
              <span id="speedDisplay">0.0 קמ"ש</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">סנכרון אחרון מהשרת</span>
              <span id="lastSeenDisplay" class="text-emerald-400">מתחבר...</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Keep-Alive & Controls (4 Cols) -->
    <div class="lg:col-span-4 flex flex-col gap-4">

      <!-- Keep-Alive Status Card -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-lg">
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
            <i data-lucide="radio" class="w-4 h-4 text-emerald-400"></i>
            ערוץ תקשורת ו-Keep-Alive
          </h3>
          <span id="channelBadge" class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            ערוץ פעיל
          </span>
        </div>

        <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 space-y-2.5 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-slate-400">התקשרות אחרונה:</span>
            <span id="exactTimestamp" class="font-mono text-slate-200 font-semibold">--:--:--</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-400">זמן שחלף:</span>
            <span id="timeElapsedText" class="font-mono text-emerald-400 font-bold">מעדכן...</span>
          </div>
        </div>
      </div>

      <!-- Cloud API Configuration -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 shadow-lg">
        <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2 mb
